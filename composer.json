{
    "name": "mauricesvay/moonmoon",
    "description": "Moonmoon is a simple feed aggregator.",
    "homepage": "http://moonmoon.org/",
    "type": "project",
    "license": "BSD",
    "authors": [
        {
            "name": "Maurice Svay",
            "email": "maurice@svay.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^7.4 || ^8.0",
        "mustangostang/spyc": "0.5.1",
        "simplepie/simplepie": "^1.9",
        "paragonie/random_compat": "^2.0"
    },
    "require-dev": {},
    "scripts": {
        "test": ""
    },
    "autoload": {
        "psr-0": {
            "": "app/classes/",
            "SimplePie": "vendor/simplepie/simplepie/library"
        },
        "psr-4": {
            "SimplePie\\": "vendor/simplepie/simplepie/src"
        },
        "files": [
            "app/helpers.php"
        ]
    }
}
